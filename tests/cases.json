 "_comment_mtc": [
  "The PRIMITIVE constructor _make_tiled_copy(atom, layout_tv, tiler_mn). CuTe just",
  "stores the two, so the reference records what the TiledCopy reports back and the",
  "JS side checks its parse of the same strings (mtcParseTiler + parseLayout).",
  "The `op` field is optional and defaults to universal. The directional cases",
  "mirror universal ones with the same tv/tiler: since all six SIMT Ops give an",
  "identical Atom, the TiledCopy must be identical too, and run.js checks them",
  "against the same expectations. This is what stops the three tabs' shared Op",
  "picker from silently mattering."
 ],
 "make_tiled_copy": [
  {
   "id": "mtc-cpasync",
